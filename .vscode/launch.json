                // "--wandb_name", "vsDebug",
                "--hparams", "{\"backbone\": \"resnet18-BN\", \"batch_size\": 32}",
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "1"
            },
            "justMyCode": true,
            "cwd": "${workspaceFolder}/benchmarks/T3A"
        },

